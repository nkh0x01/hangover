DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_NAME="კრეატორები"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payment provider selection.
#   mock   — local hosted page at /payments/mock-bog/[id]  (DEFAULT for dev)
#   bog    — Bank of Georgia e-commerce (production)
#   tbc    — TBC iPay (not implemented yet)
#   stripe — Stripe (not implemented yet, requires forex layer for GEL)
PAYMENTS_PROVIDER="mock"

# Platform commission charged to creator on every completed order.
PLATFORM_COMMISSION_PERCENT="12"

# Bank of Georgia e-commerce — required when PAYMENTS_PROVIDER=bog.
# Get these from https://business.bog.ge → e-commerce → integration.
BOG_CLIENT_ID=""
BOG_CLIENT_SECRET=""
BOG_CALLBACK_SECRET=""
# Override the base URLs in tests / staging
# BOG_API_BASE="https://api.bog.ge/payments/v1"
# BOG_OAUTH_URL="https://oauth2.bog.ge/auth/realms/bog/protocol/openid-connect/token"

