APP_NAME="ქართული წარმოება"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tbilisi
APP_URL=http://localhost:8001

APP_LOCALE=ka
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ka_GE

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# For local non-docker development: sqlite. For docker/production: mysql.
DB_CONNECTION=sqlite

# Uncomment for MySQL via docker-compose:
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=marketplace
# DB_USERNAME=marketplace
# DB_PASSWORD=marketplace

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=marketplace

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Meilisearch for product search (Laravel Scout)
SCOUT_DRIVER=database
SCOUT_QUEUE=false
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@marketplace.local"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible storage for product images and seller docs (MinIO in dev)
AWS_ACCESS_KEY_ID=marketplace
AWS_SECRET_ACCESS_KEY=marketplace-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=products
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Marketplace business knobs
MARKETPLACE_NAME_KA="ქართული წარმოება"
MARKETPLACE_NAME_EN="Made in Georgia Market"
MARKETPLACE_CURRENCY=GEL
MARKETPLACE_COMMISSION_PCT=0
MARKETPLACE_COD_ENABLED=true
MARKETPLACE_DEFAULT_SHIPPING_GEL=10.00

VITE_APP_NAME="${APP_NAME}"
