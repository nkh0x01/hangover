# Hotel PMS · STAGING env template
# ──────────────────────────────────────────────────────────────────────
#  1. Copy this file to .env at the project root on the server.
#  2. Generate APP_KEY:        php artisan key:generate
#  3. Fill in DB_* with your cPanel / Plesk MySQL credentials.
#  4. Set STAGING_DEMO_PASSWORD to a strong shared demo password.
# ──────────────────────────────────────────────────────────────────────

APP_NAME="Hotel PMS (staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tbilisi
APP_URL=https://hotel.365sakartvelo.com

APP_LOCALE=ka
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ── Database (cPanel/Plesk MySQL) ───────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=          # e.g. cpaneluser_hotelpms
DB_USERNAME=          # e.g. cpaneluser_hotel
DB_PASSWORD=

# ── Sessions / cache / queue: file driver, shared-host safe ────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=hotel.365sakartvelo.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
CACHE_PREFIX=hotelpms_staging

QUEUE_CONNECTION=sync

# ── Mail: log driver only on staging — never send to real guests ───
MAIL_MAILER=log

# ── Force HTTPS even behind cPanel's proxy ─────────────────────────
ASSET_URL=https://hotel.365sakartvelo.com
FORCE_HTTPS=true

# ── Demo seed password (read by AdminUserSeeder + DemoReservationsSeeder)
# This is the password shared for the staging demo logins. Set it to
# something long and non-obvious; staging is still public on the internet.
STAGING_DEMO_PASSWORD=

# ── Channel manager: keep dry-run mode for ALL channels on staging ─
CHANNEL_DRY_RUN=true

# ── Sentry / error reporting (optional) ────────────────────────────
# SENTRY_LARAVEL_DSN=
