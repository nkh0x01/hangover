# ----------------------------------------------------------------------
# Hangover Mobility Platform — backend environment
# Copy to .env and adjust. NEVER commit a populated .env.
# ----------------------------------------------------------------------

APP_NAME="Hangover Mobility"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=ka
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ka_GE

# Minimum mobile client versions; clients below this get app.outdated (426).
APP_MIN_VERSION_IOS=1.0.0
APP_MIN_VERSION_ANDROID=1.0.0

LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=debug

# ---- Database ---------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hangover
DB_USERNAME=hangover
DB_PASSWORD=hangover

# ---- Cache / queue / sessions / Redis --------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_BROADCAST_DB=3

# ---- Broadcasting / Reverb -------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=hangover
REVERB_APP_KEY=hangover-key
REVERB_APP_SECRET=change-me-in-prod
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Mobile clients connect to:
REVERB_HOST_CLIENT=localhost
REVERB_PORT_CLIENT=8080
REVERB_SCHEME_CLIENT=ws

# ---- Sanctum ---------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1
SANCTUM_TOKEN_TTL_MINUTES=43200            # 30 days
SANCTUM_REFRESH_GRACE_MINUTES=10080        # 7 days

# ---- Mail -------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@hangover.app"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Filesystems / S3 (MinIO locally) --------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=hangover
AWS_SECRET_ACCESS_KEY=hangover-secret
AWS_DEFAULT_REGION=eu-central-1
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_BUCKET=avatars
AWS_BUCKET_DRIVER_DOCS=driver-docs
AWS_BUCKET_EXPORTS=exports

# ---- SMS (OTP) -------------------------------------------------------
# driver: twilio | sender_ge | null
SMS_DRIVER=sender_ge
SMS_FROM="Ride360"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SENDER_GE_API_KEY=
SENDER_GE_SENDER=Ride360
SENDER_GE_BASE_URL=https://sender.ge/api/send.php

# ---- Push (FCM) ------------------------------------------------------
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
FIREBASE_PROJECT_ID=

# ---- OAuth -----------------------------------------------------------
GOOGLE_CLIENT_ID_CUSTOMER=
GOOGLE_CLIENT_ID_DRIVER=
APPLE_CLIENT_ID_CUSTOMER=
APPLE_CLIENT_ID_DRIVER=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# ---- Payments --------------------------------------------------------
PAYMENTS_DEFAULT_GATEWAY=stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ---- Maps ------------------------------------------------------------
GEO_PROVIDER=google
GOOGLE_MAPS_SERVER_KEY=
MAPBOX_ACCESS_TOKEN=

# ---- Observability ---------------------------------------------------
SENTRY_LARAVEL_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=hangover-backend

# ---- Telescope (dev only) --------------------------------------------
TELESCOPE_ENABLED=true

# ---- Feature flags / safety -----------------------------------------
IDEMPOTENCY_TTL_HOURS=24
RATELIMIT_OTP_PER_PHONE_PER_HOUR=5
