{
  "cli": {
    "version": ">= 18.11.0",
    "appVersionSource": "local",
    "requireCommit": false
  },
  "build": {
    "customer-ios-testflight": {
      "distribution": "store",
      "channel": "customer-production",
      "autoIncrement": false,
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_APP_TARGET": "customer",
        "EXPO_PUBLIC_APP_ROLE": "customer",
        "EXPO_PUBLIC_APP_NAME": "Ride 360 Customer V2",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://ride.365sakartvelo.com"
      }
    },
    "driver-ios-testflight": {
      "distribution": "store",
      "channel": "driver-production",
      "autoIncrement": false,
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_APP_TARGET": "driver",
        "EXPO_PUBLIC_APP_ROLE": "driver",
        "EXPO_PUBLIC_APP_NAME": "Ride 360 Driver V2",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://ride.365sakartvelo.com"
      }
    }
  },
  "submit": {
    "customer-ios-testflight": {
      "ios": {}
    },
    "driver-ios-testflight": {
      "ios": {}
    }
  }
}
