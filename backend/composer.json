{
    "name": "hangover/backend",
    "type": "project",
    "description": "Hangover Mobility Platform — Laravel 11 backend (API, admin, queues, realtime).",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-intl": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "laravel/framework": "^11.30",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "laravel/horizon": "^5.27",
        "laravel/reverb": "^1.4",
        "laravel/socialite": "^5.16",
        "socialiteproviders/apple": "^5.7",
        "filament/filament": "^3.2",
        "spatie/laravel-permission": "^6.10",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-medialibrary": "^11.10",
        "spatie/laravel-data": "^4.11",
        "propaganistas/laravel-phone": "^5.3",
        "mcamara/laravel-localization": "^2.2",
        "kreait/laravel-firebase": "^6.0",
        "spatie/laravel-health": "^1.30",
        "dedoc/scramble": "^0.11",
        "predis/predis": "^2.2",
        "sentry/sentry-laravel": "^4.10",
        "symfony/uid": "^7.1",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.18",
        "laravel/telescope": "^5.2",
        "laravel/sail": "^1.33",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.4",
        "larastan/larastan": "^3.0",
        "pestphp/pest": "^3.5",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": ["./vendor/bin/pest --colors=always"],
        "stan": ["./vendor/bin/phpstan analyse --memory-limit=1G"],
        "pint": ["./vendor/bin/pint"]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
