APP_NAME="Gadget AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://admin.gadget.ge
APP_TIMEZONE=Asia/Tbilisi
APP_LOCALE=ka

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gadget_chatbot
DB_USERNAME=gadget
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# ---- WhatsApp Business Cloud API ----
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v20.0

# ---- Facebook Messenger ----
MESSENGER_VERIFY_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=

# ---- Instagram Direct + comments ----
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# ---- Facebook page (comments) ----
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ---- Claude (Anthropic) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-opus-4-7
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=1024

# ---- Catalog source ----
CATALOG_SOURCE_URL=https://gadget.ge/api/products
CATALOG_SYNC_INTERVAL_MIN=15

# ---- Payments (PSP) ----
PAYMENT_PROVIDER=bog
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_RETURN_URL=https://admin.gadget.ge/payments/return
PAYMENT_FAIL_URL=https://admin.gadget.ge/payments/fail

# ---- Escalation ----
ESCALATION_WHATSAPP_TO=995599000000
ESCALATION_ADMIN_URL=https://admin.gadget.ge/inbox

# ---- Chatbot behavior ----
CHATBOT_DEBOUNCE_MIN=5
CHATBOT_DEBOUNCE_MAX=15
CHATBOT_TYPING_MIN_MS=800
CHATBOT_TYPING_PER_CHAR_MS=22
CHATBOT_TYPING_MAX_MS=6000
CHATBOT_MIN_CONFIDENCE=0.62
CHATBOT_WORKING_HOURS_START=10
CHATBOT_WORKING_HOURS_END=22
